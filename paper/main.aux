\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Pre-registered primary endpoint $\Delta \text  {ECE}_{\text  {OOD}}$ for TS across 60 seed experiments (6 pairs $\times $ 2 architectures $\times $ 5 seeds, $B=10{,}000$, BCa operating CI). ``Support'' = 95\% CI lower bound $>0$. Nine counter-examples are transparently disclosed. Full 5-seed coverage on both architectures for all 6 directions.}}{61}{table.1}\protected@file@percent }
\newlabel{tab:primary_60seed}{{1}{61}{Pre-registered primary endpoint $\Delta \text {ECE}_{\text {OOD}}$ for TS across 60 seed experiments (6 pairs $\times $ 2 architectures $\times $ 5 seeds, $B=10{,}000$, BCa operating CI). ``Support'' = 95\% CI lower bound $>0$. Nine counter-examples are transparently disclosed. Full 5-seed coverage on both architectures for all 6 directions}{table.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces ID boundary condition $\Delta \text  {ECE}_{\text  {ID}}$ for TS (12 pair$\times $architecture strata, 5 seeds each). ``CI$\cap $0'' = number of seed cells whose 95\% CI contains zero. The pre-registered boundary criterion ($\geq $80\% of cells with CI containing zero) is \emph  {not} met: 23/60 cells (38.3\%) contain zero (BCa operating CI) and 34/60 have CI lower bound $>0$, triggering the pre-registered ``ID nonzero boundary'' branch (protocol A1.4.2).}}{62}{table.2}\protected@file@percent }
\newlabel{tab:boundary}{{2}{62}{ID boundary condition $\Delta \text {ECE}_{\text {ID}}$ for TS (12 pair$\times $architecture strata, 5 seeds each). ``CI$\cap $0'' = number of seed cells whose 95\% CI contains zero. The pre-registered boundary criterion ($\geq $80\% of cells with CI containing zero) is \emph {not} met: 23/60 cells (38.3\%) contain zero (BCa operating CI) and 34/60 have CI lower bound $>0$, triggering the pre-registered ``ID nonzero boundary'' branch (protocol A1.4.2)}{table.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Method-selection boundary: 8 methods $\times $ 6 transfer pairs $\times $ 5 seeds (InceptionTime). Support rate $=$ fraction of seeds with 95\% CI lower bound $>0$. ``Full'' = number of directions with 5/5 full support. ``Neg.\ dirs'' $=$ number of the 6 transfer directions whose 5-seed mean $\Delta \text  {ECE}_{\text  {OOD}}$ is negative. TS is the most robust parametric recalibrator; EM and Matrix scaling are the most fragile on InceptionTime (15/30 each); on ResNet1D, Matrix scaling (17/30) is the most fragile, EM reaches 19/30. \textit  {Caveat:} 6 cells with $w_{\text  {ID}} > 10$ exhibit prior-weight drift up to 130.5; after exclusion, EM OOD $\Delta $ECE mean flips from $-0.0127$ to $+0.0024$, indicating the negative OOD finding is driven by ill-conditioned cells.}}{63}{table.3}\protected@file@percent }
\newlabel{tab:methods}{{3}{63}{Method-selection boundary: 8 methods $\times $ 6 transfer pairs $\times $ 5 seeds (InceptionTime). Support rate $=$ fraction of seeds with 95\% CI lower bound $>0$. ``Full'' = number of directions with 5/5 full support. ``Neg.\ dirs'' $=$ number of the 6 transfer directions whose 5-seed mean $\Delta \text {ECE}_{\text {OOD}}$ is negative. TS is the most robust parametric recalibrator; EM and Matrix scaling are the most fragile on InceptionTime (15/30 each); on ResNet1D, Matrix scaling (17/30) is the most fragile, EM reaches 19/30. \textit {Caveat:} 6 cells with $w_{\text {ID}} > 10$ exhibit prior-weight drift up to 130.5; after exclusion, EM OOD $\Delta $ECE mean flips from $-0.0127$ to $+0.0024$, indicating the negative OOD finding is driven by ill-conditioned cells}{table.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Architecture robustness for TS: InceptionTime vs.\ ResNet1D across 6 transfer pairs, full 5-seed coverage on both architectures. Architecture robustness is supported on both InceptionTime (27/30, 90.0\%) and ResNet1D (24/30, 80.0\%) with complete 5-seed coverage on all 6 directions. ResNet1D shows a direction-specific deficit on CPSC$\rightarrow $Chapman and CPSC$\rightarrow $PTB-XL (3/5 each), not a global architecture deficit.}}{64}{table.4}\protected@file@percent }
\newlabel{tab:arch_robust}{{4}{64}{Architecture robustness for TS: InceptionTime vs.\ ResNet1D across 6 transfer pairs, full 5-seed coverage on both architectures. Architecture robustness is supported on both InceptionTime (27/30, 90.0\%) and ResNet1D (24/30, 80.0\%) with complete 5-seed coverage on all 6 directions. ResNet1D shows a direction-specific deficit on CPSC$\rightarrow $Chapman and CPSC$\rightarrow $PTB-XL (3/5 each), not a global architecture deficit}{table.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Predictability LOO $R^2$ (multi-architecture merged). All methods trigger the failure branch (CI upper bound $<0.5$). The three-step chain is downgraded to a two-step chain per the pre-registered failure branch.}}{65}{table.5}\protected@file@percent }
\newlabel{tab:predictability}{{5}{65}{Predictability LOO $R^2$ (multi-architecture merged). All methods trigger the failure branch (CI upper bound $<0.5$). The three-step chain is downgraded to a two-step chain per the pre-registered failure branch}{table.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Deployment criterion sensitivity / specificity at varying thresholds (raw ECE $>$ threshold $\rightarrow $ predict ``deploy TS''). Optimal Youden $J=0.124$ at threshold $0.127$.}}{65}{table.6}\protected@file@percent }
\newlabel{tab:deploy_sens}{{6}{65}{Deployment criterion sensitivity / specificity at varying thresholds (raw ECE $>$ threshold $\rightarrow $ predict ``deploy TS''). Optimal Youden $J=0.124$ at threshold $0.127$}{table.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Trivial strategy comparison. Mean $\Delta \text  {ECE}$; negative $=$ beneficial (ECE reduction). always-none and always-buy-$n$-labels span all 1230 (method, shift) cells; always-TS is evaluated on the 157 (pair, seed, shift) cells with complete results and lookup-table on 155 (two cells whose in-sample best method is unavailable are dropped). The lookup table captures most of the TS benefit without target labels.}}{66}{table.7}\protected@file@percent }
