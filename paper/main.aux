\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Primary endpoint $\Delta \text  {ECE}_{\text  {OOD}}$ by transfer direction, grouped by architecture (TS only, 60 seed experiments). Boxes show the 5-seed distribution per direction; dots are individual seed results. The dashed line marks zero OOD benefit. Support counts (e.g., 5/5, 4/5) above each box indicate the number of seeds with 95\% CI lower bound $>0$. InceptionTime achieves 27/30 (90\%), ResNet1D achieves 24/30 (80\%).}}{16}{figure.2}\protected@file@percent }
\newlabel{fig:main_results}{{2}{16}{Primary endpoint $\Delta \text {ECE}_{\text {OOD}}$ by transfer direction, grouped by architecture (TS only, 60 seed experiments). Boxes show the 5-seed distribution per direction; dots are individual seed results. The dashed line marks zero OOD benefit. Support counts (e.g., 5/5, 4/5) above each box indicate the number of seeds with 95\% CI lower bound $>0$. InceptionTime achieves 27/30 (90\%), ResNet1D achieves 24/30 (80\%)}{figure.2}{}}
